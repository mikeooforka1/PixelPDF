# Export these variables in the backend terminal/hosting dashboard.
# This file is an example; it is not automatically loaded.
OCR_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OCR_DEVICE=cpu
OCR_CPU_THREADS=2
OCR_TIMEOUT_SECONDS=240
OCR_PROFILE=cpu
OCR_DETECTION_SIDE=1600
# Optional explicit model overrides take precedence over OCR_PROFILE.
# OCR_DETECTION_MODEL=PP-OCRv5_server_det
# OCR_RECOGNITION_MODEL=PP-OCRv5_server_rec
